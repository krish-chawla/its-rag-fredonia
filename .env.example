OPENAI_API_KEY=

# --- Human escalation ---
# Relevance score (0-1) below which the bot hands off instead of answering.
# Run `python its_rag.py` and check the "top relevance" lines to calibrate.
ESCALATION_MIN_RELEVANCE=0.3
# Where tickets are always logged (JSONL). Contains user contact info — keep out of git.
ESCALATION_LOG_PATH=escalations/tickets.jsonl

# Optional: email tickets to the help desk. Pointing this at the ticketing
# system's email-intake address creates real tickets. Leave blank to only log.
ITS_HELPDESK_EMAIL=
ESCALATION_SMTP_HOST=
ESCALATION_SMTP_PORT=587
ESCALATION_SMTP_USER=
ESCALATION_SMTP_PASSWORD=
ESCALATION_FROM_EMAIL=
